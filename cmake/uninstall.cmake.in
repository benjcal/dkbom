set(manifest "@CMAKE_CURRENT_BINARY_DIR@/install_manifest.txt")
if(NOT EXISTS "${manifest}")
  message(FATAL_ERROR "no install manifest: nothing installed from this build tree")
endif()
file(STRINGS "${manifest}" installed)
foreach(path IN LISTS installed)
  set(f "$ENV{DESTDIR}${path}")
  if(EXISTS "${f}" OR IS_SYMLINK "${f}")
    message(STATUS "Removing ${f}")
    file(REMOVE "${f}")
  endif()
endforeach()
